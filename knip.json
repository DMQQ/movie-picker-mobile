{
  "entry": [
    "src/app/**/*.{ts,tsx}",
    "src/app/_layout.tsx"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "!src/**/*.test.{ts,tsx}"
  ],
  "ignore": [
    "src/app/**",
    "**/*.d.ts"
  ],
  "ignoreDependencies": [
    "babel-preset-expo",
    "babel-plugin-react-compiler",
    "patch-package",
    "expo",
    "react",
    "react-native",
    "@types/*"
  ],
  "ignoreExportsUsedInFile": true
}
