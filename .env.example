# PostHog (public client configuration)
EXPO_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_your_project_token_here
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# PostHog CLI credentials for native symbol/sourcemap upload in EAS Release builds
# (create a personal API key in PostHog: settings → personal API keys; EU host for CLI is https://eu.posthog.com)
POSTHOG_CLI_API_KEY=phx_your_personal_api_key_here
POSTHOG_CLI_PROJECT_ID=your_project_id
POSTHOG_CLI_HOST=https://eu.posthog.com
