{
  "expo": {
    "platforms": ["ios", "android"],
    "name": "FlickMate",
    "slug": "qr-mobile",
    "version": "4.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon-dark.png",
    "userInterfaceStyle": "dark",
    "scheme": "flickmate",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "FlickMate uses your camera to scan QR codes for joining movie games. You can also join manually without camera access.",
          "microphonePermission": false
        }
      ],
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Bebas",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Bebas.ttf",
                    "weight": 400
                  }
                ]
              }
            ]
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/icon-light.png",
          "imageWidth": 200
        }
      ],
      "expo-sqlite",
      [
        "expo-router",
        {
          "root": "./src/app"
        }
      ],
      "expo-secure-store",
      "expo-localization",
      "expo-image",
      "expo-sharing",
      "expo-status-bar",
      "expo-apple-authentication",
      [
        "react-native-nitro-google-signin",
        {
          "iosGoogleServicesFile": "./GoogleService-Info.plist"
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "flickmate-mobile",
          "organization": "dmq"
        }
      ]
    ],
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "appStoreUrl": "https://apps.apple.com/us/app/flickmate-movie-finder/id6741321848",
      "buildNumber": "20260520",
      "supportsTablet": true,
      "icon": "./assets/images/icon.icon",
      "infoPlist": {
        "NSCameraUsageDescription": "FlickMate uses your camera to scan QR codes for joining movie games. You can also join manually without camera access.",
        "NSCameraUsageDescription_pl": "FlickMate używa aparatu do skanowania kodów QR, aby dołączyć do gier filmowych. Możesz również dołączyć ręcznie bez dostępu do aparatu.",
        "NSPhotoLibraryUsageDescription": "FlickMate accesses your photos to let you set a profile avatar.",
        "UIViewControllerBasedStatusBarAppearance": true,
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "pl.dmq.movie-picker",
      "associatedDomains": ["applinks:flickmate.app"],
      "appleTeamId": "55RA6Q9VSR",
      "usesAppleSignIn": true
    },
    "android": {
      "playStoreUrl": "https://play.google.com/store/apps/details?id=pl.dmq.moviepicker",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "permissions": ["android.permission.CAMERA"],
      "package": "pl.dmq.moviepicker",
      "versionCode": 202605201,
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "flickmate"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        },
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "https",
              "host": "flickmate.app",
              "pathPrefix": "/"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "ab2d7ea0-e25f-4063-a2e2-1a449547340b"
      }
    },
    "runtimeVersion": "6.0.0",
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "updates": {
      "url": "https://flickmate.app/api/manifest",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 1500,
      "runtimeVersion": "6.0.0"
    }
  }
}
